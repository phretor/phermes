# Lean image for booting a built PHermes disk in QEMU under OVMF (UEFI).
# Kept separate from the phermes-build image so the builder stays minimal.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 \
    ovmf \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/qemu-boot.sh /usr/local/bin/qemu-boot.sh
RUN chmod +x /usr/local/bin/qemu-boot.sh

ENTRYPOINT ["/usr/local/bin/qemu-boot.sh"]
